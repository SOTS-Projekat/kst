@prefix ex: <http://example.org/kst/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Item a rdfs:Class .

ex:KnowledgeDomain a rdfs:Class .

ex:implies a rdf:Property .

<http://example.org/kst/knowledgeDomain/latest_iita> a ex:KnowledgeDomain ;
    rdfs:label "latest_iita" ;
    ex:generatedAt "2026-02-09T18:26:05.522002"^^xsd:dateTime .

<http://example.org/kst/item/1> a ex:Item ;
    rdfs:label "Item 1" ;
    ex:implies <http://example.org/kst/item/0>,
        <http://example.org/kst/item/2>,
        <http://example.org/kst/item/3> .

<http://example.org/kst/item/2> a ex:Item ;
    rdfs:label "Item 2" ;
    ex:implies <http://example.org/kst/item/0>,
        <http://example.org/kst/item/1>,
        <http://example.org/kst/item/3> .

<http://example.org/kst/item/0> a ex:Item ;
    rdfs:label "Item 0" .

<http://example.org/kst/item/3> a ex:Item ;
    rdfs:label "Item 3" .

